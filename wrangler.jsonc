{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2024-01-01",
  "pages_build_output_dir": "./",
  "compatibility_flags": ["nodejs_compat"],

  // KV namespace for per-user rate limiting (concurrency caps on /api/generate, /api/grok, /api/fal).
  // Setup steps:
  //   1. Cloudflare Dashboard → Workers & Pages → KV → Create namespace → name it "authorr-rate-limit"
  //   2. Pages → authorr-ai → Settings → Functions → KV namespace bindings
  //      → Add: Variable name = RATE_LIMIT_KV, KV namespace = authorr-rate-limit
  //   3. For local dev: replace YOUR_KV_NAMESPACE_ID below with the ID shown in the KV dashboard.
  //      Run: wrangler pages dev . --kv RATE_LIMIT_KV=YOUR_KV_NAMESPACE_ID
  //
  // Workers plan note: free tier allows 1,000 KV writes/day (~1-2 full books).
  // Workers Paid ($5/mo) includes 1M writes/day — recommended for any production load.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "907f0110b7744d87936a4ccffdef2a03"
    }
  ]
}
